# Database
DATABASE_URL=postgres://signal:signal_dev_password@localhost:5432/signal

# Redis (optional — live visitors, rate limiting)
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=change-me-32-byte-random-secret-key
SESSION_COOKIE_NAME=signal_session
APP_URL=http://localhost:3000

# Ingestion
COLLECT_RATE_LIMIT_PER_MINUTE=600
MAX_BATCH_EVENTS=50
MAX_PAYLOAD_BYTES=65536

# GeoIP (optional local MaxMind GeoLite2-City .mmdb path)
GEOIP_DB_PATH=

# Feature flags
PUBLIC_REGISTRATION_ENABLED=false

{
  "name": "signal",
  "version": "0.1.0",
  "private": true,
  "description": "SIGNAL — Universal Website Visitor Intelligence by RDCS GENIX",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @signal/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @signal/db",
    "db:migrate": "npm run db:migrate -w @signal/db",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "sdk:build": "npm run build -w @signal/sdk",
    "seed": "npm run seed -w @signal/db"
  },
  "engines": {
    "node": ">=20"
  }
}
